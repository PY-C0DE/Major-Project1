# Environment Configuration for AlphaQuant AI Platform

# Server & Runtime
PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Comma-separated CORS origin allowlist (exact origin strings; never '*')
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://aistudio.google.com

# PostgreSQL Configuration (Cloud SQL / Docker Postgres)
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=alphaquant
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
# TLS is verified (rejectUnauthorized: true) by default when SQL_SSL=true or connecting to remote TCP hosts
SQL_SSL=
SQL_SSL_CA=
# Explicit insecure override (emits security warning; avoid in production)
SQL_SSL_REJECT_UNAUTHORIZED=

# Security & Authentication
# Generate a strong secret before production deployment: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_DEMO_MODE=false
VITE_DEMO_MODE=false

# Market Data Provider (default: yahoo | optional licensed provider: twelvedata)
MARKET_DATA_PROVIDER=yahoo
TWELVE_DATA_API_KEY=

# External AI & Financial Data APIs (Optional / Enhanced)
GEMINI_API_KEY=
NEWS_API_KEY=
FRED_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Model Configuration
CONFIDENCE_LEVEL=0.90
REGIME_COMPONENTS=2
DRIFT_P_VALUE_THRESHOLD=0.05
RANDOM_SEED=42

# Email Verification & Password Reset Mail Provider (SMTP or Resend)
# If neither SMTP nor RESEND_API_KEY + MAIL_FROM is configured, mail-sending auth endpoints return HTTP 503.
APP_BASE_URL=http://localhost:3000
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Durable Background Job Queue (BullMQ + Redis)
# In development only, omits Redis with an explicit warning; production fails closed unless configured.
JOB_QUEUE_BACKEND=in-memory
REDIS_URL=
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_MS=1000
ALLOW_IN_PROCESS_JOB_QUEUE=false

# Compliance & Legal Operator Placeholders (Step 7)
COMPLIANCE_OPERATOR_NAME=[OPERATOR_LEGAL_ENTITY]
COMPLIANCE_OPERATOR_ADDRESS=[OPERATOR_ADDRESS]
COMPLIANCE_CONTACT_EMAIL=[OPERATOR_CONTACT_EMAIL]
COMPLIANCE_DPO_EMAIL=[DPO_CONTACT]
COMPLIANCE_JURISDICTION=[GOVERNING_JURISDICTION]
COMPLIANCE_DISCLAIMER_TEXT=Statistical machine learning outputs (forecasts, conformal prediction intervals, regime labels, and sentiment scores) are provided for educational and research evaluation only and do not constitute investment, financial, legal, or tax advice.
VITE_DISCLAIMER_TEXT=

